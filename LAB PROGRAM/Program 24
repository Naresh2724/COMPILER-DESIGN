lex

%{
#include <stdio.h>

int comment_lines = 0;
FILE *out;
%}

%option noyywrap

%x COMMENT

%%

"/*" {
    BEGIN(COMMENT);
    comment_lines++;
}

<COMMENT>"*/" {
    BEGIN(INITIAL);
}

<COMMENT>\n {
    comment_lines++;
}

<COMMENT>. {
}

"//".* {
    comment_lines++;
}

\n {
    fprintf(out, "\n");
}

. {
    fprintf(out, "%s", yytext);
}

%%

int main()
{
    yyin = fopen("input.c", "r");
    out = fopen("output.c", "w");

    if (yyin == NULL || out == NULL)
    {
        printf("File cannot be opened\n");
        return 1;
    }

    yylex();

    printf("Number of comment lines = %d\n", comment_lines);

    fclose(yyin);
    fclose(out);

    return 0;
}
