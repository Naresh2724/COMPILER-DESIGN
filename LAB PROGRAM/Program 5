#include <stdio.h>

int main()
{
    char s[200];
    int i, spaces = 0, newlines = 0;

    printf("Enter a statement: ");
    fgets(s, 200, stdin);

    for(i = 0; s[i] != '\0'; i++)
    {
        if(s[i] == ' ' || s[i] == '\t')
            spaces++;

        if(s[i] == '\n')
            newlines++;
    }

    printf("Number of whitespaces: %d\n", spaces);
    printf("Number of newlines: %d\n", newlines);

    return 0;
}
