
#include <stdio.h>

int main()
{
    char op[10], arg1[10], arg2[10], result[10];

    printf("Enter the intermediate code:\n");
    scanf("%s %s %s %s", result, arg1, op, arg2);

    printf("\nGenerated Target Code:\n");

    if (op[0] == '+')
        printf("MOV R0, %s\nADD R0, %s\n", arg1, arg2);
    else if (op[0] == '-')
        printf("MOV R0, %s\nSUB R0, %s\n", arg1, arg2);
    else if (op[0] == '*')
        printf("MOV R0, %s\nMUL R0, %s\n", arg1, arg2);
    else if (op[0] == '/')
        printf("MOV R0, %s\nDIV R0, %s\n", arg1, arg2);

    printf("MOV %s, R0\n", result);

    return 0;
}
