#include <stdio.h>
#include <string.h>

int main()
{
    char input[200];

    printf("Enter a line: ");
    fgets(input, sizeof(input), stdin);

    /* Check for single-line comment */
    if (input[0] == '/' && input[1] == '/')
    {
        printf("It is a comment.\n");
    }

    /* Check for multi-line comment */
    else if (strstr(input, "/*") != NULL &&
             strstr(input, "*/") != NULL)
    {
        printf("It is a comment.\n");
    }

    else
    {
        printf("It is not a comment.\n");
    }

    return 0;
}
