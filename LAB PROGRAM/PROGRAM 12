
#include <stdio.h>
#include <string.h>

char input[50];
int i = 0;

int E();
int T();
int F();

int E1()
{
    if(input[i] == '+')
    {
        i++;
        if(T())
            return E1();
        return 0;
    }
    return 1;
}

int T1()
{
    if(input[i] == '*')
    {
        i++;
        if(F())
            return T1();
        return 0;
    }
    return 1;
}

int F()
{
    if(input[i] == 'i')
    {
        i++;
        return 1;
    }

    if(input[i] == '(')
    {
        i++;
        if(E() && input[i] == ')')
        {
            i++;
            return 1;
        }
    }
    return 0;
}

int T()
{
    if(F())
        return T1();
    return 0;
}

int E()
{
    if(T())
        return E1();
    return 0;
}

int main()
{
    printf("Enter expression: ");
    scanf("%s", input);

    if(E() && input[i] == '\0')
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
