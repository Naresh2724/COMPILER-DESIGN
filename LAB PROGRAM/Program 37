
%{
#include <stdio.h>
#include <string.h>

char search[50];
int count = 0;
%}

%option noyywrap

%%

[a-zA-Z]+ {
    if (strcmp(yytext, search) == 0)
        count++;
}

[ \t\n]+ { }

. { }

%%

int main()
{
    printf("Enter the word to search: ");
    scanf("%49s", search);

    printf("Enter a sentence:\n");
    getchar();

    yylex();

    printf("Frequency of %s = %d\n", search, count);

    return 0;
}
